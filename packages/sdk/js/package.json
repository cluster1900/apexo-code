{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@apexo/sdk",
  "version": "1.18.35",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "bun ./script/build.ts",
    "check:generated": "bun ./script/build.ts && git diff --exit-code -- src/v2/gen"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./v2": "./src/v2/index.ts",
    "./v2/client": "./src/v2/client.ts",
    "./v2/gen/client": "./src/v2/gen/client/index.ts",
    "./v2/server": "./src/v2/server.ts",
    "./v2/types": "./src/v2/gen/types.gen.ts",
    "./v2/command-prompt": "./src/v2/command-prompt.ts",
    "./v2/task-message": "./src/v2/task-message.ts",
    "./v2/mcp-attachment": "./src/v2/mcp-attachment.ts"
    ,"./v2/feedback-images": "./src/v2/feedback-images.ts"
    ,"./v2/session-report": "./src/v2/session-report.ts"
    ,"./v2/goal-command": "./src/v2/goal-command.ts"
    ,"./v2/grok-commands": "./src/v2/grok-commands.ts"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@hey-api/openapi-ts": "0.90.10",
    "@tsconfig/node22": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "cross-spawn": "catalog:"
  }
}
