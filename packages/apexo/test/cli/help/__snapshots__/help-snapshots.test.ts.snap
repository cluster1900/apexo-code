exports[`apexo CLI help-text snapshots every documented command emits stable help text: apexo acp --help 1`] = `
"apexo acp

start an ACP server

Options:
  -h, --help         show help                                                             [boolean]
  -v, --version      show version number                                                   [boolean]
      --print-logs   print logs to stderr                                                  [boolean]
      --log-level    log level                  [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                          [boolean]
      --memory       enable memory; --no-memory force-disables it for this process         [boolean]
      --port         port to listen on                                         [number] [default: 0]
      --hostname     hostname to listen on                           [string] [default: "127.0.0.1"]
      --mdns         enable mDNS service discovery (defaults hostname to 0.0.0.0)
                                                                          [boolean] [default: false]
      --mdns-domain  custom domain name for mDNS service (default: apexo.local)
                                                                   [string] [default: "apexo.local"]
      --cors         additional domains to allow for CORS                      [array] [default: []]
      --backend      ACP backend        [string] [choices: "apexo", "grok-build"] [default: "apexo"]
      --cwd          working directory [string] [default: "<HOME>"]"
`;

exports[`apexo CLI help-text snapshots every documented command emits stable help text: apexo mcp --help 1`] = `
"apexo mcp

manage MCP (Model Context Protocol) servers

Commands:
  apexo mcp add [name]     add an MCP server
  apexo mcp list           list MCP servers and their status                           [aliases: ls]
  apexo mcp auth [name]    authenticate with an OAuth-enabled MCP server
  apexo mcp logout [name]  remove OAuth credentials for an MCP server
  apexo mcp debug <name>   debug OAuth connection for an MCP server

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]
      --memory      enable memory; --no-memory force-disables it for this process          [boolean]"
`;

exports[`apexo CLI help-text snapshots every documented command emits stable help text: apexo attach --help 1`] = `
"apexo attach <url>

attach to a running apexo server

Positionals:
  url  http://localhost:4096                                                     [string] [required]

Options:
  -h, --help              show help                                                        [boolean]
  -v, --version           show version number                                              [boolean]
      --print-logs        print logs to stderr                                             [boolean]
      --log-level         log level             [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure              run without external plugins                                     [boolean]
      --memory            enable memory; --no-memory force-disables it for this process    [boolean]
      --dir               directory to run in                                               [string]
  -c, --continue          continue the last session                                        [boolean]
      --session-protocol  Session API transport for attach (auto preserves server detection)
                                      [choices: "auto", "native", "compatibility"] [default: "auto"]
  -s, --session           session id to continue                                            [string]
      --fork              fork the session when continuing (use with --continue or --session)
                                                                                           [boolean]
  -p, --password          basic auth password (defaults to APEXO_SERVER_PASSWORD)           [string]
  -u, --username          basic auth username (defaults to APEXO_SERVER_USERNAME or 'apexo')[string]
      --mini              start the minimal interactive interface         [boolean] [default: false]
      --no-replay         disable mini session history replay on resume and after resize   [boolean]
      --replay-limit      cap visible mini replay to the newest N messages                  [number]"
`;

exports[`apexo CLI help-text snapshots every documented command emits stable help text: apexo run --help 1`] = `
"apexo run [message..]

run apexo with a message

Positionals:
  message  message to send                                                     [array] [default: []]

Options:
  -h, --help                     show help                                                 [boolean]
  -v, --version                  show version number                                       [boolean]
      --print-logs               print logs to stderr                                      [boolean]
      --log-level                log level      [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure                     run without external plugins                              [boolean]
      --memory                   enable memory; --no-memory force-disables it for this process
                                                                                           [boolean]
      --command                  the command to run, use message for args                   [string]
  -c, --continue                 continue the last session                                 [boolean]
      --session-protocol         Session API transport (native also enables local execution)
                                      [choices: "auto", "native", "compatibility"] [default: "auto"]
  -s, --session                  session id or title to continue                            [string]
      --input-id                 exact native headless input retry (requires --session)     [string]
      --fork                     fork the session before continuing (requires --continue or
                                 --session)                                                [boolean]
  -m, --model                    model to use in the format of provider/model               [string]
      --agent                    agent to use                                               [string]
      --format                   format: default (formatted), json (completed events), or
                                 streaming-json (Grok Build event stream)
                        [string] [choices: "default", "json", "streaming-json"] [default: "default"]
      --profile                  runtime profile for the local server
                                                           [string] [choices: "apexo", "grok-build"]
  -f, --file                     file(s) to attach to message                                [array]
      --title                    title for the session (uses truncated prompt if no value provided)
                                                                                            [string]
      --attach                   attach to a running apexo server (e.g., http://localhost:4096)
                                                                                            [string]
  -p, --password                 basic auth password (defaults to APEXO_SERVER_PASSWORD)    [string]
  -u, --username                 basic auth username (defaults to APEXO_SERVER_USERNAME or 'apexo')
                                                                                            [string]
      --dir                      directory to run in, path on remote server if attaching    [string]
      --port                     port for the local server (defaults to random port if no value
                                 provided)                                                  [number]
      --variant                  model variant (provider-specific reasoning effort, e.g., high, max,
                                 minimal)                                                   [string]
      --thinking                 show thinking blocks                                      [boolean]
      --wait-for-background      wait for background work the prompt started and print the follow-up
                                 turns it triggers (use --no-wait-for-background to exit after the
                                 first turn)                               [boolean] [default: true]
      --background-wait-timeout  seconds to wait for background work after the latest turn ends
                                 before stopping it and exiting 1            [number] [default: 600]
  -i, --interactive              run in direct interactive split-footer mode
                                                                          [boolean] [default: false]
      --auto                     auto-approve permissions that are not explicitly denied
                                 (dangerous!)                             [boolean] [default: false]"
`;

