{
  "$schema": "https://raw.githubusercontent.com/cluster1900/apexo-grok/main/schemas/theme.json",
  "defs": {
    "vesperBg": "#101010",
    "vesperPanel": "#161616",
    "vesperElement": "#1e1e1e",
    "vesperFg": "#FFFFFF",
    "vesperComment": "#8b8b8b",
