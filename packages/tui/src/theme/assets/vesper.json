      "dark": "vesperString",
      "light": "vesperLightSecondary"
    },
    "syntaxNumber": {
      "dark": "vesperNumber",
      "light": "vesperLightPrimary"
    },
    "syntaxType": {
      "dark": "vesperFunction",
      "light": "vesperLightPrimary"
    },
    "syntaxOperator": {
      "dark": "vesperKeyword",
      "light": "vesperLightMuted"
    },
    "syntaxPunctuation": {
      "dark": "vesperFg",
      "light": "vesperLightFg"
    }
